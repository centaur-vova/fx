{
    "swagger": "2.0",
    "info": {
        "description": "Task status receiver and semaphore API",
        "title": "Fast Atomic Flow API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/auth/token": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Returns a signed JWT token valid for 24 hours",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Generate JWT token",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/auth.TokenResponse"
                        }
                    },
                    "400": {
                        "description": "invalid request body",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/semaphore/acquire": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Acquires a slot in the distributed semaphore. Returns a unique slot UID on success.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Acquire semaphore slot",
                "parameters": [
                    {
                        "description": "Semaphore acquire request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/semaphore.AcquireRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "invalid JSON body",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "no available slots",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/semaphore/health": {
            "get": {
                "description": "Returns 200 OK",
                "produces": [
                    "application/json"
                ],
                "summary": "Semaphore health check",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/semaphore/release": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Releases a slot identified by its UID. Idempotent — releasing an already released slot is a no-op.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "text/plain"
                ],
                "summary": "Release semaphore slot",
                "parameters": [
                    {
                        "description": "Slot UID to release",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/semaphore.ReleaseRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Slot released (or was already free)"
                    },
                    "400": {
                        "description": "invalid request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "redis connection error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/task/status": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "summary": "SendStatus receives task status update and publishes to NATS.",
                "parameters": [
                    {
                        "description": "Task status",
                        "name": "status",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/protocol.TaskStatusUpdate"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted"
                    },
                    "400": {
                        "description": "invalid JSON body",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "failed to publish to NATS",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "auth.TokenResponse": {
            "type": "object",
            "properties": {
                "expires_at": {
                    "type": "integer"
                },
                "token": {
                    "type": "string"
                }
            }
        },
        "protocol.TaskStatusUpdate": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "mc": {
                    "type": "integer",
                    "default": 1,
                    "maximum": 255,
                    "minimum": 1
                },
                "mode": {
                    "type": "string",
                    "enum": [
                        "observation",
                        "stress"
                    ]
                },
                "progress": {
                    "type": "integer",
                    "default": 0
                },
                "sem": {
                    "type": "string",
                    "enum": [
                        "shared",
                        "api"
                    ]
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "check_lock",
                        "progress",
                        "completed",
                        "lock_acquired",
                        "lock_failed",
                        "retries_failed",
                        "retry"
                    ]
                },
                "worker": {
                    "type": "integer",
                    "default": 0
                }
            }
        },
        "semaphore.AcquireRequest": {
            "type": "object",
            "properties": {
                "lock_wait_timeout": {
                    "type": "integer",
                    "minimum": 0,
                    "example": 1
                },
                "max_concurrent": {
                    "type": "integer",
                    "maximum": 255,
                    "minimum": 1,
                    "example": 5
                },
                "permit_ttl": {
                    "type": "integer",
                    "maximum": 60,
                    "minimum": 1,
                    "example": 2
                }
            }
        },
        "semaphore.ReleaseRequest": {
            "type": "object",
            "properties": {
                "uid": {
                    "type": "string",
                    "example": "5:3"
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}