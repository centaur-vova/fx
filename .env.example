# === Server Infrastructure ===
# 0.0.0.0 listens on all interfaces (Docker friendly)
SERVER_HOST=0.0.0.0
SERVER_PORT=9501
# Number of Swoole workers (usually matches CPU cores)
SERVER_WORKER_NUM=6
# Dispatch mode 2 is Fixed (FD based) for WebSocket stability
SERVER_DISPATCH_MODE=2
# Socket's receive and send buffer sizes for TCP/UDP connections
SOCKET_BUFFER_SIZE_MB=64

# === Rate limiter ===
# JSON: {"limiter_name":{"max_attempts":int,"ttl":int}}
RATE_LIMITERS={"create-tasks":{"max_attempts":10,"ttl":60},"purge-queue":{"max_attempts":5,"ttl":300}}

# === Logging ===
# Available levels: debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=info

# === Shared Memory & Queues ===
# Maximum number of tasks allowed in the queue
# When full, new tasks are rejected
QUEUE_CAPACITY=10000
# Messages per pull from queue
QUEUE_PREFETCH_BATCH=5

# === SEMAPHORES ===
# Default semaphore permit TTL (in seconds). Used only with the "api" semaphore (via go-proxy).
# When using the API directly, this value should be passed explicitly.
SEMAPHORE_PERMIT_TTL=10

# === Task Engine Concurrency ===
# Max tasks per single batch request
TASK_MAX_BATCH_SIZE=2000
# Max concurrency (demo)
TASK_SEMAPHORE_MAX_LIMIT=255
# Lock timeout
TASK_LOCK_TIMEOUT_SEC=5
# Retry task processing when semaphore is closed in
TASK_RETRY_DELAY_SEC=2
# Max retry attempts
TASK_MAX_RETRIES=3

# === Real-time & Monitoring ===
# WebSocket metrics broadcast frequency (ms)
METRICS_UPDATE_INTERVAL_MS=1000
# How long to wait for active tasks during "make stop" (sec)
GRACEFUL_SHUTDOWN_TIMEOUT_SEC=5

# === WEBSOCKETS ===
WS_PORT=8080
WS_URL=ws://localhost:8080/ws

# === API ===
# Go proxy API URL (used by PHP to access the proxy for demo purposes)
API_URL=http://localhost:8080
# Authentication token for API requests
API_TOKEN=reptile

# === NATS CONNECTION ===
NATS_HOST=deez-nutz
NATS_PORT=4222
NATS_TOKEN=alfa-omega
# response timeout
NATS_TIMEOUT_SEC=1
# NATS protocol ping interval (seconds). Keeps the connection alive on the protocol level.
NATS_PING_INTERVAL_SEC=10
# Application-level ping interval from Swoole workers (seconds). Prevents connection from being closed by firewalls or load balancers due to inactivity.
NATS_WORKER_PING_INTERVAL_SEC=5

# === NATS STREAMS ===
NATS_STREAM_TASKS=tasks
NATS_SUBJECT_TASKS=v1.task.stream
NATS_CONSUMER_TASKS=php-task-consumers # durable consumer name

# === NATS BROADCAST ===
NATS_SUBJECT_BROADCAST=v1.ws.broadcast

# === NATS CONSUMER SETTINGS ===
NATS_ACK_WAIT_MS=30000

# === TASK META CACHE ===
TASK_META_TTL_SEC=10           # How long to keep task receipt after completion
TASK_META_CACHE_SIZE=65536     # Max concurrent tasks (cache slots)

# === CACHE FOR DOMAIN LAYER (auto‑flow, temporary data, etc.) ===
CACHE_STORAGE_DRIVER=swoole_table
CACHE_DEFAULT_TTL_SEC=60
CACHE_MAX_SIZE=131072
CACHE_AUTO_CLEAN_SEC=60
# Maximum size of a single cache value in bytes (Swoole table only — other drivers may ignore this)
CACHE_VALUE_MAX_SIZE=256

