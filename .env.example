# === Server Infrastructure ===
# 0.0.0.0 listens on all interfaces (Docker friendly)
SERVER_HOST=0.0.0.0
SERVER_PORT=9501
# Number of Swoole workers (usually matches CPU cores)
SERVER_WORKER_NUM=6
# Dispatch mode 2 is Fixed (FD based) for WebSocket stability
SERVER_DISPATCH_MODE=2
# Socket's receive and send buffer sizes for TCP/UDP connections
SOCKET_BUFFER_SIZE_MB=64

# === Logging ===
# Available levels: debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=warning

# === Shared Memory & Queues ===
# Maximum number of tasks allowed in the queue
# When full, new tasks are rejected
QUEUE_CAPACITY=10000
# Messages per pull from queue
QUEUE_PREFETCH_BATCH=5

# === Task Engine Concurrency ===
# Max tasks per single batch request
TASK_MAX_BATCH_SIZE=5000
# Max concurrency (demo)
TASK_SEMAPHORE_MAX_LIMIT=10
# Lock timeout
TASK_LOCK_TIMEOUT_SEC=4
# Retry task processing when semaphore is closed in
TASK_RETRY_DELAY_SEC=2
# Max retry attempts
TASK_MAX_RETRIES=3
# Task handling strategy
STRESS_MIN_TASK_NUM=1000

# === Real-time & Monitoring ===
# WebSocket metrics broadcast frequency (ms)
METRICS_UPDATE_INTERVAL_MS=1000
# How long to wait for active tasks during "make stop" (sec)
GRACEFUL_SHUTDOWN_TIMEOUT_SEC=5

# === WEBSOCKETS ===
WS_PORT=8080

# === NATS CONNECTION ===
NATS_HOST=nutz
NATS_PORT=4222
NATS_TOKEN=
NATS_TIMEOUT_SEC=1          # response timeout
NATS_PING_INTERVAL_SEC=10   # keepalive

# === NATS STREAMS ===
NATS_STREAM_TASKS=tasks
NATS_SUBJECT_TASKS=v1.task.stream
NATS_CONSUMER_TASKS=php-task-consumers # durable consumer name

# === NATS BROADCAST ===
NATS_SUBJECT_BROADCAST=v1.ws.broadcast

# === NATS CONSUMER SETTINGS ===
NATS_ACK_WAIT_MS=10000

# === TASK META CACHE (Swoole Table) ===
TASK_META_TTL_SEC=10           # How long to keep task receipt after completion
TASK_META_CACHE_SIZE=65536     # Max concurrent tasks (cache slots)
